<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ida_mission</name>
  <version>1.0.0</version>
  <description>
    Mavi İnci İDA — Görev yönetimi paketi.
    P1/P2/P3 durum makinesi, kapı hesaplama ve kamikaze görsel servo.
  </description>
  <maintainer email="ieeegesb@gmail.com">IEEE Ege Mavi İnci Yazılım Ekibi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>std_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>ida_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
